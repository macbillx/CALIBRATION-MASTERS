# PostgreSQL connection for application data and user profiles.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Base URL used by the app's Auth.js configuration.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Used only to provision the first administrator when no admin exists.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Required to deliver email verification codes and password reset links.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="Calibration Masters <no-reply@example.com>"
